{
  "name": "myownnotion",
  "version": "0.1.0",
  "private": true,
  "description": "Single-owner self-hosted knowledge workspace — canonical content foundations",
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "10.33.3"
  },
  "scripts": {
    "toolchain:check": "tsx scripts/ci/check-toolchain.ts",
    "ci:test-impact": "node scripts/ci/test-impact.ts",
    "ci:test:affected": "node scripts/ci/run-affected-vitest.ts",
    "shell:check": "tsx scripts/ci/check-shell.ts",
    "format:check": "biome format .",
    "format:write": "biome format --write .",
    "lint": "biome lint .",
    "lint:ci": "biome ci .",
    "typecheck": "pnpm -r run typecheck && tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run --project domain --project contracts --project blob-store --project client-core --project web --project workspace-contract",
    "test:property": "vitest run --project domain --project contracts --project blob-store --project client-core property",
    "test:integration": "vitest run --project database-integration",
    "test:contract": "vitest run --project api-contract --project workspace-contract",
    "test:migration": "vitest run --project database-integration packages/database/tests/migrations.integration.spec.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --fail-on-flaky-tests",
    "test:e2e:local": "bash scripts/test-e2e-local.sh",
    "test:e2e:gate": "MYOWNNOTION_E2E_JOBS=1 bash scripts/test-e2e-local.sh",
    "test:e2e:firefox-container": "bash scripts/test-e2e-firefox-container.sh",
    "test:performance": "vitest run --project performance",
    "test:reference-backups": "vitest run --project database-integration packages/database/tests/reference-backups.integration.spec.ts",
    "test:security": "vitest run --project domain --project contracts --project database-integration --project api-contract --project workspace-contract security",
    "security:audit": "pnpm audit --audit-level=high --prod",
    "security:secrets": "tsx scripts/ci/scan-secrets.ts",
    "security:static": "tsx scripts/ci/static-security.ts",
    "security:licenses": "tsx scripts/ci/license-policy.ts",
    "compose:check": "tsx scripts/ci/check-compose.ts",
    "images:build": "tsx scripts/ci/build-images.ts",
    "release:gate": "tsx scripts/ci/check-release-gate.ts",
    "checks:local": "pnpm toolchain:check && pnpm shell:check && pnpm format:check && pnpm lint:ci && pnpm typecheck && pnpm test:coverage && pnpm test:integration && pnpm db:test-migrations && pnpm test:contract && pnpm test:e2e:gate && pnpm build && pnpm images:build && pnpm security:audit && pnpm security:secrets && pnpm security:static && pnpm security:licenses && pnpm compose:check",
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "admin": "pnpm --filter @myownnotion/api admin",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:test-migrations": "vitest run --project database-integration packages/database/tests/migrations.integration.spec.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.3.11",
    "@myownnotion/blob-store": "workspace:*",
    "@myownnotion/contracts": "workspace:*",
    "@myownnotion/database": "workspace:*",
    "@myownnotion/domain": "workspace:*",
    "@myownnotion/test-utils": "workspace:*",
    "@playwright/test": "^1.58.1",
    "@types/node": "^24.10.9",
    "@types/pg": "^8.15.6",
    "@vitest/coverage-v8": "^3.2.4",
    "ajv": "8.20.0",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.2",
    "fast-check": "^4.5.3",
    "pg": "^8.16.3",
    "tsx": "^4.20.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "yaml": "^2.8.2"
  }
}
