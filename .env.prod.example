# Copy to .env.prod, replace the password, and keep .env.prod untracked.

# Published image selector. Prefer an immutable sha-<full-commit> tag.
MYOWNNOTION_IMAGE_TAG=latest
MYOWNNOTION_VCS_REF=replace-with-the-full-commit-hash

# PostgreSQL. Replace this value even for local-only evaluation.
MYOWNNOTION_DB_NAME=myownnotion
MYOWNNOTION_DB_USER=myownnotion
MYOWNNOTION_DB_PASSWORD=replace-with-a-long-random-password
MYOWNNOTION_DB_PORT=5432

# Private S3-compatible storage. The object service publishes no host port.
# Replace both credentials; keep this file outside version control in production.
MYOWNNOTION_S3_REGION=us-east-1
MYOWNNOTION_S3_BUCKET=myownnotion-private
MYOWNNOTION_S3_ACCESS_KEY=replace-with-a-random-storage-access-key
MYOWNNOTION_S3_SECRET_KEY=replace-with-a-long-random-storage-secret
MYOWNNOTION_S3_PREFIX=blobs

# Encrypted backups. Both host paths must already exist and remain outside the checkout.
# Put a mode-0600 file named restic-password in the secrets directory. It must be
# readable by the non-root operations user (UID/GID 1000 in the pinned image).
# Add rclone.conf there only for an rclone: destination, with the same ownership.
MYOWNNOTION_BACKUP_SECRETS_DIR=/absolute/path/to/myownnotion-backup-secrets
MYOWNNOTION_BACKUP_DESTINATION=/absolute/path/on-a-separate-backup-disk
MYOWNNOTION_RESTIC_REPOSITORY=/var/lib/myownnotion/backup-destination
MYOWNNOTION_BACKUP_SCHEDULE_UTC=02:00
MYOWNNOTION_BACKUP_KEEP_DAILY=7
MYOWNNOTION_BACKUP_KEEP_WEEKLY=4
MYOWNNOTION_BACKUP_KEEP_MONTHLY=12

# Loopback-only host ports.
MYOWNNOTION_API_PORT=3001
MYOWNNOTION_WEB_PORT=8080
