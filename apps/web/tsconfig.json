{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["bun", "node", "vite/client"],
    "allowImportingTsExtensions": true
  },
  "include": ["build.ts", "src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
