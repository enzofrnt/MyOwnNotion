{
  "name": "@myownnotion/api",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical content HTTP API (Fastify, loopback-only until authentication)",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.build.json --noEmit",
    "dev": "bun --watch src/server.ts",
    "build": "bun build.ts",
    "start": "bun dist/server.js",
    "migrate": "bun dist/migrate.js",
    "admin": "bun src/admin/admin-cli.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^9.4.0",
    "@fastify/websocket": "^11.3.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@myownnotion/blob-store": "workspace:*",
    "@myownnotion/contracts": "workspace:*",
    "@myownnotion/database": "workspace:*",
    "@myownnotion/domain": "workspace:*",
    "@myownnotion/page-state": "workspace:*",
    "@simplewebauthn/server": "^13.3.2",
    "@sinclair/typebox": "^0.34.41",
    "csv-parse": "7.0.2",
    "drizzle-orm": "^0.45.2",
    "fast-json-stringify": "7.0.1",
    "fastify": "^5.7.4",
    "loro-crdt": "1.14.1",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "yaml": "2.9.0",
    "yauzl": "3.4.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@myownnotion/test-utils": "workspace:*",
    "@types/mdast": "4.0.4",
    "@types/pg": "^8.15.6",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "3.4.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
