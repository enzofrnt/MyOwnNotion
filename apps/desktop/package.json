{
  "name": "@myownnotion/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron host for the MyOwnNotion web client. Installed only with Bun 1.4.0; Electron Forge reads this package's node_modules (no pnpm, npm, or Yarn).",
  "type": "module",
  "main": ".vite/build/bootstrap.js",
  "productName": "MyOwnNotion",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "bun ../../scripts/desktop/dev.ts",
    "build": "bun build.ts",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-base": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/osx-sign": "1.3.3",
    "@reforged/maker-appimage": "5.2.0",
    "electron": "44.1.1"
  }
}
