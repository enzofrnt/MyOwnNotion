{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myownnotion.local/contracts/canvas-block.schema.json",
  "title": "Canvas block attributes version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["canvasId", "schemaVersion", "cards", "connections", "strokes", "viewport"],
  "properties": {
    "canvasId": { "$ref": "#/$defs/uuid" },
    "schemaVersion": { "const": 1 },
    "cards": {
      "type": "array",
      "maxItems": 500,
      "items": { "oneOf": [{ "$ref": "#/$defs/textCard" }, { "$ref": "#/$defs/pageCard" }] }
    },
    "connections": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/connection" }
    },
    "strokes": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/stroke" }
    },
    "viewport": { "$ref": "#/$defs/viewport" }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "coordinate": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
    "cardBase": {
      "type": "object",
      "properties": {
        "cardId": { "$ref": "#/$defs/uuid" },
        "x": { "$ref": "#/$defs/coordinate" },
        "y": { "$ref": "#/$defs/coordinate" },
        "width": { "type": "number", "minimum": 160, "maximum": 800 },
        "height": { "type": "number", "minimum": 96, "maximum": 600 }
      },
      "required": ["cardId", "x", "y", "width", "height"]
    },
    "textCard": {
      "allOf": [
        { "$ref": "#/$defs/cardBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["cardId", "kind", "x", "y", "width", "height", "text"],
          "properties": {
            "cardId": { "$ref": "#/$defs/uuid" },
            "kind": { "const": "text" },
            "x": { "$ref": "#/$defs/coordinate" },
            "y": { "$ref": "#/$defs/coordinate" },
            "width": { "type": "number", "minimum": 160, "maximum": 800 },
            "height": { "type": "number", "minimum": 96, "maximum": 600 },
            "text": { "type": "string", "minLength": 1, "maxLength": 4000 }
          }
        }
      ]
    },
    "pageCard": {
      "allOf": [
        { "$ref": "#/$defs/cardBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["cardId", "kind", "x", "y", "width", "height", "targetItemId"],
          "properties": {
            "cardId": { "$ref": "#/$defs/uuid" },
            "kind": { "const": "page" },
            "x": { "$ref": "#/$defs/coordinate" },
            "y": { "$ref": "#/$defs/coordinate" },
            "width": { "type": "number", "minimum": 160, "maximum": 800 },
            "height": { "type": "number", "minimum": 96, "maximum": 600 },
            "targetItemId": { "$ref": "#/$defs/uuid" }
          }
        }
      ]
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connectionId", "sourceCardId", "targetCardId", "label"],
      "properties": {
        "connectionId": { "$ref": "#/$defs/uuid" },
        "sourceCardId": { "$ref": "#/$defs/uuid" },
        "targetCardId": { "$ref": "#/$defs/uuid" },
        "label": { "type": "string", "maxLength": 120 }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "$ref": "#/$defs/coordinate" },
        "y": { "$ref": "#/$defs/coordinate" }
      }
    },
    "stroke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strokeId", "width", "points"],
      "properties": {
        "strokeId": { "$ref": "#/$defs/uuid" },
        "width": { "enum": [2, 4, 8] },
        "points": {
          "type": "array",
          "minItems": 2,
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/point" }
        }
      }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "zoom"],
      "properties": {
        "x": { "$ref": "#/$defs/coordinate" },
        "y": { "$ref": "#/$defs/coordinate" },
        "zoom": { "type": "number", "minimum": 0.25, "maximum": 4 }
      }
    }
  }
}
