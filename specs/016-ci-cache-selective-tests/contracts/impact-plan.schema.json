{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myownnotion.local/contracts/impact-plan.schema.json",
  "title": "CI impact plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "event",
    "baseSha",
    "headSha",
    "changedPaths",
    "deletedPaths",
    "mode",
    "vitest",
    "e2e",
    "cacheScope",
    "reasons",
    "unknownPaths"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "event": {
      "type": "string",
      "minLength": 1
    },
    "baseSha": {
      "type": ["string", "null"]
    },
    "headSha": {
      "type": "string",
      "minLength": 1
    },
    "changedPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "deletedPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "mode": {
      "enum": ["none", "affected", "full"]
    },
    "vitest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "sourceFiles", "testFiles", "groups"],
      "properties": {
        "mode": {
          "enum": ["none", "related", "direct", "mixed", "full"]
        },
        "sourceFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "testFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "groups": {
          "type": "array",
          "items": {
            "enum": ["unit", "integration", "contract", "performance"]
          },
          "uniqueItems": true
        }
      }
    },
    "e2e": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "testFiles", "lanes", "matrix"],
      "properties": {
        "mode": {
          "enum": ["none", "selected", "full"]
        },
        "testFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "matrix": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["project", "lane", "laneId"],
            "properties": {
              "project": {
                "type": "string",
                "minLength": 1
              },
              "lane": {
                "type": "string",
                "pattern": "^[0-9]+/[0-9]+$"
              },
              "laneId": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "lanes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "project", "index", "total", "testFiles", "estimatedSeconds"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+-[0-9]+-[0-9]+$"
              },
              "project": {
                "type": "string",
                "minLength": 1
              },
              "index": {
                "type": "integer",
                "minimum": 1
              },
              "total": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              },
              "testFiles": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "estimatedSeconds": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "cacheScope": {
      "type": "string",
      "minLength": 1
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unknownPaths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
