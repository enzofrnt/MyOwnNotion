{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myownnotion.local/contracts/task-document-v4.schema.json",
  "title": "MyOwnNotion task item attributes, document version 4",
  "type": "object",
  "additionalProperties": false,
  "required": ["checked", "taskId", "status", "dueDate", "priority"],
  "properties": {
    "checked": { "type": "boolean" },
    "taskId": { "type": "string", "format": "uuid" },
    "status": {
      "enum": ["todo", "in_progress", "completed", "cancelled"]
    },
    "dueDate": {
      "oneOf": [{ "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }, { "type": "null" }]
    },
    "priority": { "enum": ["none", "low", "medium", "high"] }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "completed" } } },
      "then": { "properties": { "checked": { "const": true } } },
      "else": { "properties": { "checked": { "const": false } } }
    }
  ]
}
