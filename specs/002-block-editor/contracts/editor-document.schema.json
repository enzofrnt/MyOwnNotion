{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myownnotion.local/contracts/editor-document-v2.schema.json",
  "title": "MyOwnNotion Editor Document v2",
  "$ref": "#/$defs/document",
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "content"],
      "properties": {
        "type": { "const": "doc" },
        "content": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/block" } }
      }
    },
    "mark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": { "type": { "enum": ["bold", "italic", "strike", "code"] } }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "text" },
        "text": { "type": "string", "minLength": 1 },
        "marks": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/mark" } }
      }
    },
    "plainText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "text" },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "paragraph" },
        "content": { "type": "array", "items": { "$ref": "#/$defs/text" } }
      }
    },
    "heading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "attrs"],
      "properties": {
        "type": { "const": "heading" },
        "attrs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level"],
          "properties": { "level": { "enum": [1, 2, 3] } }
        },
        "content": { "type": "array", "items": { "$ref": "#/$defs/text" } }
      }
    },
    "blockquote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "content"],
      "properties": {
        "type": { "const": "blockquote" },
        "content": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/block" } }
      }
    },
    "codeBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "codeBlock" },
        "attrs": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "language": { "type": ["string", "null"] } }
        },
        "content": { "type": "array", "items": { "$ref": "#/$defs/plainText" } }
      }
    },
    "horizontalRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": { "type": { "const": "horizontalRule" } }
    },
    "listItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "content"],
      "properties": {
        "type": { "const": "listItem" },
        "content": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/block" } }
      }
    },
    "taskItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "attrs", "content"],
      "properties": {
        "type": { "const": "taskItem" },
        "attrs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["checked"],
          "properties": { "checked": { "type": "boolean" } }
        },
        "content": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/block" } }
      }
    },
    "regularList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "content"],
      "properties": {
        "type": { "enum": ["bulletList", "orderedList"] },
        "attrs": { "type": "object" },
        "content": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/listItem" } }
      }
    },
    "taskList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "content"],
      "properties": {
        "type": { "const": "taskList" },
        "content": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/taskItem" } }
      }
    },
    "block": {
      "oneOf": [
        { "$ref": "#/$defs/paragraph" },
        { "$ref": "#/$defs/heading" },
        { "$ref": "#/$defs/blockquote" },
        { "$ref": "#/$defs/codeBlock" },
        { "$ref": "#/$defs/horizontalRule" },
        { "$ref": "#/$defs/regularList" },
        { "$ref": "#/$defs/taskList" }
      ]
    }
  }
}
