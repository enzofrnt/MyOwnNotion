# Local HTTPS helper for `compose.dev.yaml`.
#
# This is not the official stack. Certificates come from Caddy's internal CA
# (`tls internal` / `local_certs`) so passkeys and `__Host-` cookies work on
# https://localhost:8443. Trust the CA once with `bun run dev:trust` in a
# system browser. Embedded browsers such as Cursor's do not use that trust
# store; they should open http://localhost:8080 instead of clicking through
# ERR_CERT_AUTHORITY_INVALID.
{
	admin 127.0.0.1:2019
	local_certs
	auto_https disable_redirects
}

(app) {
	request_body {
		max_size 2GB
	}

	# Vite serves many unbundled modules in this helper. Compress public shell
	# assets, but leave API, auth/recovery, private files and MCP outside it.
	@public_shell {
		not path /v1* /mcp* /health*
	}
	encode @public_shell {
		gzip 1
	}

	handle /v1* {
		# Initial catch-up carries large JSON pages. Restrict compression to
		# this read endpoint; realtime SSE and secret-bearing replies stream
		# through the existing proxy unchanged, without compression buffering.
		@change_page {
			method GET
			path /v1/changes
		}
		encode @change_page {
			gzip 1
			match {
				header Content-Type application/json*
			}
		}
		reverse_proxy api:3001 {
			header_up Host {host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-For {remote_host}
			flush_interval -1
			transport http {
				read_timeout 75s
				write_timeout 75s
			}
		}
	}

	handle /mcp* {
		reverse_proxy api:3001 {
			header_up Host {host}
			header_up X-Forwarded-Proto {scheme}
			flush_interval -1
		}
	}

	handle /health {
		reverse_proxy api:3001 {
			header_up Host {host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle {
		reverse_proxy web:5173 {
			header_up Host {host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-For {remote_host}
			flush_interval -1
			# Vite's HMR WebSocket can stay idle while no source files change.
			# Keep the default unlimited I/O and stream lifetimes here: an idle
			# timeout disconnects HMR and makes Vite reload the healthy page.
		}
	}
}

localhost:8443 {
	tls internal
	import app
}

:80 {
	import app
}
