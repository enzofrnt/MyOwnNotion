# Safe development defaults — never put real secrets in this file.
# Copy to `.env` for local overrides; `.env` is gitignored.
#
# Secret policy (FR-013, FR-030): this file, the images, the logs, and ordinary
# configuration carry *paths and switches only*. Secret material is delivered
# exclusively through mounted files whose paths are named below. A variable
# whose name ends in `_FILE` holds a path, never a value.

# --- PostgreSQL development instance (docker compose up -d postgres) ---------
MYOWNNOTION_DB_NAME=myownnotion
MYOWNNOTION_DB_USER=myownnotion
MYOWNNOTION_DB_PORT=5432
# Development-only convenience password. Production supplies the database
# password through MYOWNNOTION_DB_PASSWORD_FILE and leaves this unset.
MYOWNNOTION_DB_PASSWORD=myownnotion-dev
# MYOWNNOTION_DB_PASSWORD_FILE=/run/secrets/db-password

# Connection string used by host-side processes: `pnpm dev`, `pnpm db:migrate`,
# and the integration tests. The host reaches PostgreSQL through the port the
# development override publishes on the loopback interface.
#
# The Compose stack does NOT read this value. Compose auto-loads `.env`, and
# inside a container 127.0.0.1 is the container itself, so an inherited
# DATABASE_URL made the API fail with ECONNREFUSED against its own loopback.
# `compose.yaml` therefore composes its own URL against the `postgres` service
# from MYOWNNOTION_DB_USER/PASSWORD/NAME above.
DATABASE_URL=postgres://myownnotion:myownnotion-dev@127.0.0.1:5432/myownnotion

# --- API server -------------------------------------------------------------
# Every published port binds the loopback interface only. HTTPS termination is
# the hosting administrator's reverse proxy, outside this Compose stack.
MYOWNNOTION_API_HOST=127.0.0.1
MYOWNNOTION_API_PORT=3001

# --- Web dev server ---------------------------------------------------------
MYOWNNOTION_WEB_HOST=127.0.0.1
MYOWNNOTION_WEB_PORT=5173
MYOWNNOTION_API_URL=http://127.0.0.1:3001

# --- Trusted origin and reverse-proxy boundary (FR-030, FR-031) -------------
# The single public origin the owner's browser uses. Production must be https.
# WebAuthn RP ID and cookie/CSRF origin checks derive from this value.
#
# It must match the origin actually served, port included. In the Compose
# stack that is the published web port, and `compose.yaml` defaults it to
# http://127.0.0.1:${MYOWNNOTION_WEB_PORT} for exactly that reason. Behind the
# hosting administrator's reverse proxy it is the public https origin, and the
# proxy's own address belongs in MYOWNNOTION_TRUSTED_PROXY_CIDRS below.
MYOWNNOTION_PUBLIC_ORIGIN=http://127.0.0.1:5173
# Comma-separated CIDRs whose X-Forwarded-* headers are honoured. Empty means
# no proxy is trusted and forwarded headers are ignored.
MYOWNNOTION_TRUSTED_PROXY_CIDRS=
# Explicit loopback HTTP cookie exception. When 1, and only when the trusted
# request origin is loopback HTTP, the API issues the separate opaque
# `mn_dev_session` cookie (HttpOnly, SameSite=Strict, Path=/, no Secure). It
# must never issue or accept `__Host-mn_session` over HTTP.
#
# It is also what makes a prod-like stack usable on this machine: without it,
# MYOWNNOTION_PUBLIC_ORIGIN must be https, the security configuration is
# refused, and the API starts with its installation, bootstrap, authentication,
# and session routes silently unregistered — a green healthcheck and a 404 on
# login. Leave unset or 0 wherever a reverse proxy terminates HTTPS.
MYOWNNOTION_DEV_LOOPBACK_HTTP_COOKIE=1

# --- Deployment wrapping key and mounted secrets (FR-013, FR-014) -----------
# Path to the externally managed deployment wrapping key. The file must exist,
# be readable only by the API user (0400/0600), and is never persisted with
# workspace data. An unavailable or invalid key fails closed: the installation
# reports `degraded` and protected reads/writes are refused.
MYOWNNOTION_DEPLOYMENT_KEY_FILE=/run/secrets/deployment-key
# Local development fixture path (gitignored, see .gitignore `secrets/`).
# MYOWNNOTION_DEPLOYMENT_KEY_FILE=./secrets/deployment-key.dev

# --- Durable storage --------------------------------------------------------
# Encrypted content-addressed file chunks. Mounted as a durable volume.
MYOWNNOTION_BLOB_ROOT=./.dev-blobs

# --- Request limits ---------------------------------------------------------
MYOWNNOTION_MAX_REQUEST_BYTES=1048576
MYOWNNOTION_MAX_BODY_BYTES=1048576
MYOWNNOTION_MAX_FILE_BYTES=104857600

# --- Image selection (FR-032, FR-034) ---------------------------------------
# Immutable commit- or version-addressable images published to GHCR. Pin a
# digest or an exact tag; never `latest`.
#
# `latest` is not merely discouraged, it misleads: the tag is only as fresh as
# the last publish, so pulling it can hand you an image many commits behind the
# checkout you are testing, with routes the client already calls simply absent.
# CI publishes a `sha-<full-commit>` tag for every build; pin that.
MYOWNNOTION_IMAGE_REGISTRY=ghcr.io/enzofrnt/myownnotion
MYOWNNOTION_API_IMAGE=ghcr.io/enzofrnt/myownnotion-api:v0.1.0
MYOWNNOTION_WEB_IMAGE=ghcr.io/enzofrnt/myownnotion-web:v0.1.0

# --- Running the published stack on this machine ----------------------------
# `docker compose up -d` alone loads compose.override.yaml too, which builds
# the images locally. To exercise the published stack, select the base file
# only and pin both images to the same commit:
#
#   docker compose -f compose.yaml up -d
#
# Three things must line up, and each one fails in its own quiet way:
#
#   - MYOWNNOTION_API_PORT / MYOWNNOTION_WEB_PORT must be free. `pnpm dev`
#     already holds 3001, and Compose then leaves the containers `Created`
#     with no logs at all;
#   - MYOWNNOTION_PUBLIC_ORIGIN must be the origin you actually open, port
#     included. It defaults to the published web port;
#   - MYOWNNOTION_DEV_LOOPBACK_HTTP_COOKIE must be 1 for an http origin.
#     Otherwise the security configuration is refused and the API serves a
#     healthy /health with no login routes behind it. The refusal is logged —
#     check `docker compose logs api` for "security configuration was refused".
#
# Open the web port; the API is proxied under the same origin. The `migrate`
# job applies the schema before the API starts, so a first run on an empty
# volume needs nothing extra.

# --- Tests ------------------------------------------------------------------
# Integration tests: when Docker/Testcontainers is unavailable, point tests
# at an already running disposable PostgreSQL instead.
# TEST_DATABASE_URL=postgres://myownnotion:myownnotion-dev@127.0.0.1:5432/myownnotion_test
