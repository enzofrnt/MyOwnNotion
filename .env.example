# Safe development defaults — never put real secrets in this file.
# Copy to `.env` for local overrides; `.env` is gitignored.

# PostgreSQL development instance (docker compose up -d postgres)
MYOWNNOTION_DB_NAME=myownnotion
MYOWNNOTION_DB_USER=myownnotion
MYOWNNOTION_DB_PASSWORD=myownnotion-dev
MYOWNNOTION_DB_PORT=5432

# Connection string used by the API, migration runner, and integration tests.
DATABASE_URL=postgres://myownnotion:myownnotion-dev@127.0.0.1:5432/myownnotion

# API server — loopback only until authentication exists.
MYOWNNOTION_API_HOST=127.0.0.1
MYOWNNOTION_API_PORT=3001

# Web dev server.
MYOWNNOTION_WEB_PORT=5173
MYOWNNOTION_API_URL=http://127.0.0.1:3001

# Development blob store root (immutable content-addressed files).
MYOWNNOTION_BLOB_ROOT=./.dev-blobs

# Integration tests: when Docker/Testcontainers is unavailable, point tests
# at an already running disposable PostgreSQL instead.
# TEST_DATABASE_URL=postgres://myownnotion:myownnotion-dev@127.0.0.1:5432/myownnotion_test
